# Catalog Service Environment Configuration

# Database Configuration
DATABASE_URL=postgresql+asyncpg://localgrocery:dev_password_change_in_prod@localhost:5432/localgrocery

# AWS S3 Configuration (for product images)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET_NAME=localgrocery-product-images
AWS_REGION=us-east-1

# Pagination Settings
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Search Settings
SEARCH_MIN_LENGTH=2
SEARCH_MAX_RESULTS=50

# CORS Settings (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Service Port
PORT=8002
